<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.auto.audioprofile" name="Auto Audio Profile" version="1.0.0" provider-name="Bitte-ein-Git!">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.audio.profiles" version="1.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Automatically switch audio profiles based on channel count.</summary>
    <description lang="en_GB">Simple Auto Audio Profile using Add-on:Audio Profiles.. 2ch Audio = Profile2 / Multichannel = Profile1</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/Bitte-ein-Git/kodi-repo/repo/service.auto.audioprofile</source>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
