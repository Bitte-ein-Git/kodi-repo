<addon id="service.dc_ha_presence"
       name="DC Rich Presence x HA Sensors"
       version="1.9.0"
       provider-name="Bitte-ein-Git!">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.25.1"/>
        <import addon="script.module.websocket" version="0.57.0"/>
    </requires>
    <extension point="xbmc.service" library="default.py" start="startup"/>
    <extension point="xbmc.addon.metadata">
        <summary>Zeigt HA Sensoren als Discord Rich Presence.</summary>
        <description>Zur Nutzung mit custom component "kodi_helpers" geeignet.</description>
        <description>--- https://github.com/Bitte-ein-Git/ha_kodi_helpers ---</description>
        <description> Work in progress! — Discord User Token required.</description>
        <platform>all</platform>
    <source>https://github.com/Bitte-ein-Git/service.dc_ha_presence</source>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
    </extension>
</addon>