<settings>
    <category label="Discord (User Presence)">
        <setting id="app_id" type="text" label="Discord App ID" default="1244203892145786992" visible="false"/>
        <setting id="user_token" type="text" label="Discord User Token (Presence)" option="hidden"/>
    </category>
    <category label="Home Assistant">
        <setting id="ha_url" type="text" label="Home Assistant URL" default="http://homeassistant.local:8123"/>
        <setting id="ha_token" type="text" label="Home Assistant Long-Lived Token" option="hidden"/>
        <setting id="sensor_detail" type="text" label="Sensor - Details" default="sensor.details"/>
        <setting id="sensor_state" type="text" label="Sensor - State" default="sensor.state"/>
    </category>
    <category label="Customization">
        <setting id="app_name" type="text" label="App Name" default="Kodi" visible="false"/>
        <setting id="display_addon_name" type="bool" label="Display service or video addon name" default="true"/>
        <setting id="media_display_mode" type="select" label="Media display mode" values="disabled|App name|Media title" default="1"/>
        <setting id="pvr_display_mode" type="select" label="PVR display mode" values="disabled|App name|Channel name|TV-show title" default="0"/>
        <setting id="icon_color" type="select" label="Icon Color" values="Greyscale|Colored" default="0"/>
    </category>
    <category label="Bot Artwork Upload">
        <setting id="enable_bot_art" type="bool" label="Enable dynamic artwork upload (via Bot)" default="false"/>
        <setting id="bot_token" type="text" label="Discord Bot Token (Uploads)" option="hidden"/>
        <setting id="upload_channel_id" type="text" label="Discord Channel ID for Uploads" default=""/>
    </category>
</settings>
