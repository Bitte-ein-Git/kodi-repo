<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.dc_rich_presence"
       name="[COLOR royalblue]Discord Rich Presence[/COLOR] (Token Auth)"
       version="2.3.0"
       provider-name="Bitte ein Git!">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.25.1"/>
        <import addon="script.module.websocket" version="0.57.0"/>
    </requires>
    <extension point="xbmc.service" library="default.py" start="startup"/>
    <extension point="xbmc.addon.metadata">
        <summary>Shows Kodi playback as Discord Rich Presence.</summary>
        <description>Displays current Kodi playback status as Discord Rich Presence using Token authentication. Artwork is uploaded to a third-party service (ImgBB) to be displayed.</description>
        <platform>all</platform>
    <source>https://github.com/Bitte-ein-Git/kodi-repo/tree/master/repo/service.dc_rich_presence</source>
    <license>MIT</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
    </extension>
</addon>
