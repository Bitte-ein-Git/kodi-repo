<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.audioprofile.switcher" name="Audio Profile Switcher" version="1.0.0" provider-name="Bitte-ein-Git!">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.audio.profiles" version="1.0.0" optional="false"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de">Simple 1-click UI for "Audio Profiles" Addon</summary>
        <platform>all</platform>
        <assets>
          <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
